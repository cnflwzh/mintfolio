---
interface Props {
  /** Same-origin JSON generated by Core, containing { posts, index }. Loaded on first use. */
  endpoint?: string;
  /** Optional input hint; the visible label remains available to assistive technology. */
  placeholder?: string;
}
const { endpoint = import.meta.env.BASE_URL.replace(/\/$/, '') + '/search-index.json', placeholder = '搜索文章标题、摘要或正文…' } = Astro.props;
const instanceId = 'mintfolio-search-' + crypto.randomUUID();
---
<section class="mintfolio-search" data-core-search data-endpoint={endpoint} aria-label="站内全文搜索">
  <form class="mintfolio-search__form" role="search">
    <label for={instanceId + '-input'}>搜索文章</label>
    <div class="mintfolio-search__controls">
      <input id={instanceId + '-input'} data-search-input type="search" name="q" placeholder={placeholder}
        autocomplete="off" aria-controls={instanceId + '-results'} aria-describedby={instanceId + '-status'} />
      <button type="submit">搜索</button>
      <button type="button" data-search-clear hidden>清空关键词</button>
      <button type="button" data-search-reset-filters hidden>清除筛选</button>
    </div>
  </form>
  <p class="mintfolio-search__filter-summary" data-search-filter-summary hidden></p>
  <p id={instanceId + '-status'} class="mintfolio-search__status" data-search-status role="status" aria-live="polite" aria-atomic="true"></p>
  <button type="button" data-search-retry hidden>重新加载搜索索引</button>
  <ol id={instanceId + '-results'} class="mintfolio-search__results" data-search-results hidden></ol>
  <button type="button" data-search-more hidden>显示更多结果</button>
  <noscript><p>请启用 JavaScript 使用站内全文搜索。</p></noscript>
</section>
<style>
  .mintfolio-search { color: var(--mintfolio-search-color, inherit); }
  .mintfolio-search__form { display: grid; gap: .5rem; }
  .mintfolio-search__form label { font-weight: 650; }
  .mintfolio-search__controls { display: flex; flex-wrap: wrap; gap: .5rem; }
  .mintfolio-search :is(input,button) { font: inherit; color: inherit; border: 1px solid var(--mintfolio-search-border, #8887); border-radius: var(--mintfolio-search-radius, .5rem); padding: .65rem .8rem; background: var(--mintfolio-search-background, transparent); }
  .mintfolio-search input { flex: 1 1 12rem; min-width: 0; }
  .mintfolio-search button { cursor: pointer; }
  .mintfolio-search :is(input,button):focus-visible { outline: 2px solid var(--mintfolio-search-accent, currentColor); outline-offset: 3px; }
  .mintfolio-search__status, .mintfolio-search__filter-summary { margin: .75rem 0; font-size: .9rem; line-height: 1.6; }
  .mintfolio-search__status:empty { margin: 0; }
  .mintfolio-search__results { list-style: none; padding: 0; margin: 1rem 0 0; display: grid; gap: .75rem; }
  .mintfolio-search :global(.mintfolio-search__result) { padding: .9rem; border: 1px solid var(--mintfolio-search-border, #8887); border-radius: var(--mintfolio-search-radius, .5rem); background: var(--mintfolio-search-result-background, transparent); overflow-wrap: anywhere; }
  .mintfolio-search :global(.mintfolio-search__link) { font-size: 1.05rem; font-weight: 650; color: var(--mintfolio-search-accent, inherit); }
  .mintfolio-search :global(.mintfolio-search__link:focus-visible) { outline: 2px solid var(--mintfolio-search-accent, currentColor); outline-offset: 3px; }
  .mintfolio-search :global(.mintfolio-search__excerpt) { margin: .5rem 0 0; line-height: 1.7; font-size: .92rem; }
  .mintfolio-search :global(.mintfolio-search__protected) { margin-inline-start: .5rem; font-size: .8rem; }
  .mintfolio-search :global(mark) { background: var(--mintfolio-search-highlight, #d8f690); color: var(--mintfolio-search-highlight-color, #18220b); border-radius: .15rem; }
  .mintfolio-search [hidden] { display: none; }
</style>
<script>
  import { onPage } from '@mintfolio/core/client';
  import { rankSearchResults, readFiltersFromUrl, searchWithHighlights, writeFiltersToUrl } from '@mintfolio/theme-api/search';
  import type { PostFilters, SearchPayload, SearchRange } from '@mintfolio/theme-api';


  /** Validate the fields read by this widget before matching or displaying JSON. */
  function parsePayload(value: unknown): SearchPayload {
    const isRecord = (item: unknown): item is Record<string, unknown> => !!item && typeof item === 'object' && !Array.isArray(item);
    if (!isRecord(value) || !Array.isArray(value.posts) || !Array.isArray(value.index)
      || !value.posts.every((post) => isRecord(post) && typeof post.id === 'string' && typeof post.url === 'string'
        && typeof post.title === 'string' && typeof post.protected === 'boolean')
      || !value.index.every((entry) => isRecord(entry) && ['id', 'url', 'title', 'description', 'category'].every((key) => typeof entry[key] === 'string')
        && Array.isArray(entry.tags) && entry.tags.every((tag) => typeof tag === 'string')
        && (entry.text === undefined || typeof entry.text === 'string')
        && (entry.series === undefined || typeof entry.series === 'string'))) {
      throw new Error('Invalid search index');
    }
    return value as unknown as SearchPayload;
  }

  /** Highlight text using nodes only. Neither metadata nor excerpts become HTML. */
  function appendHighlighted(target: HTMLElement, text: string, ranges: readonly SearchRange[]): void {
    let offset = 0;
    for (const range of ranges) {
      target.append(document.createTextNode(text.slice(offset, range.start)));
      const mark = document.createElement('mark');
      mark.textContent = text.slice(range.start, range.end);
      target.append(mark);
      offset = range.end;
    }
    target.append(document.createTextNode(text.slice(offset)));
  }

  onPage(() => document.body, (pageRoot, scope) => {
    for (const root of pageRoot.querySelectorAll<HTMLElement>('[data-core-search]')) {
      const form = root.querySelector<HTMLFormElement>('form');
      const input = root.querySelector<HTMLInputElement>('[data-search-input]');
      const results = root.querySelector<HTMLOListElement>('[data-search-results]');
      const status = root.querySelector<HTMLElement>('[data-search-status]');
      const retry = root.querySelector<HTMLButtonElement>('[data-search-retry]');
      const clear = root.querySelector<HTMLButtonElement>('[data-search-clear]');
      const more = root.querySelector<HTMLButtonElement>('[data-search-more]');
      const resetFilters = root.querySelector<HTMLButtonElement>('[data-search-reset-filters]');
      const filterSummary = root.querySelector<HTMLElement>('[data-search-filter-summary]');
      if (!form || !input || !results || !status || !retry || !clear || !more || !resetFilters || !filterSummary) continue;

      let cache: SearchPayload | undefined;
      let pending: Promise<SearchPayload> | undefined;
      let revision = 0;
      let resultLimit = 20;
      let timer: number | undefined;
      let composing = false;
      // Only URL query parameters constrain global search. A static taxonomy
      // page's path and page.filters do not silently limit a new site-wide query.
      let taxonomy = { tag: '', category: '', series: '' };
      const eventOptions = { signal: scope.signal };

      // Reuse one lazy request per mounted widget. A failed request can be retried.
      const loadIndex = (): Promise<SearchPayload> => {
        if (cache) return Promise.resolve(cache);
        if (!pending) {
          pending = (async () => {
            const endpoint = new URL(root.dataset.endpoint ?? '/search-index.json', location.href);
            if (endpoint.origin !== location.origin || !['http:', 'https:'].includes(endpoint.protocol)) throw new Error('Search index must be same-origin');
            const response = await fetch(endpoint, { signal: scope.signal, credentials: 'same-origin' });
            if (!response.ok) throw new Error('Search index unavailable');
            cache = parsePayload(await response.json());
            return cache;
          })().catch((error: unknown) => { pending = undefined; throw error; });
        }
        return pending;
      };

      const runSearch = async (filters: PostFilters, ticket: number): Promise<void> => {
        status.textContent = filters.q ? '正在搜索…' : '正在筛选全站文章…';
        results.setAttribute('aria-busy', 'true');
        try {
          const payload = await loadIndex();
          // Typing, clearing, navigating or a newer query invalidates old work.
          if (scope.signal.aborted || ticket !== revision) return;
          const ranked = rankSearchResults(payload.index, filters);
          const matches = searchWithHighlights(ranked.slice(0, resultLimit), filters);
          const posts = new Map(payload.posts.map((post) => [post.id, post]));
          const fragment = document.createDocumentFragment();
          let displayed = 0;
          for (const match of matches) {
            if (displayed >= resultLimit) break;
            const post = posts.get(match.entry.id);
            const url = new URL(post?.url ?? match.entry.url, location.href);
            if (url.origin !== location.origin || !['http:', 'https:'].includes(url.protocol)) continue;
            const item = document.createElement('li');
            item.className = 'mintfolio-search__result';
            const link = document.createElement('a');
            link.className = 'mintfolio-search__link';
            link.href = url.href;
            appendHighlighted(link, match.entry.title, match.matches.title);
            item.append(link);
            if (post?.protected) {
              const badge = document.createElement('span');
              badge.className = 'mintfolio-search__protected';
              badge.textContent = '受保护';
              item.append(badge);
            }
            if (match.snippet.text) {
              const excerpt = document.createElement('p');
              excerpt.className = 'mintfolio-search__excerpt';
              if (match.snippet.start > 0) excerpt.append(document.createTextNode('…'));
              appendHighlighted(excerpt, match.snippet.text, match.snippet.ranges);
              if (match.snippet.end < (match.entry[match.snippet.field]?.length ?? 0)) excerpt.append(document.createTextNode('…'));
              item.append(excerpt);
            }
            fragment.append(item);
            displayed += 1;
          }
          results.replaceChildren(fragment);
          results.hidden = displayed === 0;
          more.hidden = resultLimit >= ranked.length;
          const label = filters.q ? '搜索结果' : '筛选结果';
          status.textContent = ranked.length === 0 ? '没有找到匹配的文章。'
            : displayed < ranked.length ? `${label}：共 ${ranked.length} 篇文章，显示前 ${displayed} 条。` : `${label}：共 ${displayed} 篇文章。`;
        } catch {
          if (scope.signal.aborted || ticket !== revision) return;
          status.textContent = '搜索索引加载失败，请重试。';
          retry.hidden = false;
        } finally {
          if (!scope.signal.aborted && ticket === revision) results.removeAttribute('aria-busy');
        }
      };

      const queueSearch = (immediate = false, resetLimit = true): void => {
        const ticket = ++revision;
        if (resetLimit) resultLimit = 20;
        if (timer !== undefined) window.clearTimeout(timer);
        const filters: PostFilters = { q: input.value.trim(), ...taxonomy };
        const hasTaxonomy = !!filters.tag || !!filters.category || !!filters.series;
        clear.hidden = !filters.q;
        resetFilters.hidden = filterSummary.hidden = !hasTaxonomy;
        const labels = [filters.tag && `标签「${filters.tag}」`, filters.category && `分类「${filters.category}」`, filters.series && `系列「${filters.series}」`].filter(Boolean);
        filterSummary.textContent = hasTaxonomy
          ? `全站筛选：${labels.join(' · ')}。以下显示独立筛选结果，下方归档列表仍为当前页文章。` : '';
        results.replaceChildren();
        results.hidden = retry.hidden = more.hidden = true;
        status.textContent = '';
        results.removeAttribute('aria-busy');
        if ((!filters.q && !hasTaxonomy) || composing) return;
        if (immediate) void runSearch(filters, ticket);
        else timer = scope.timeout(() => { void runSearch(filters, ticket); }, 180);
      };

      const updateUrl = (): void => {
        const url = writeFiltersToUrl({ q: input.value, ...taxonomy }, new URL(location.href));
        if (url.href !== location.href) history.replaceState(history.state, '', url);
      };
      const clearSearch = (): void => { input.value = ''; updateUrl(); queueSearch(true); input.focus(); };
      const resetTaxonomy = (clearQuery = false): void => {
        taxonomy = { tag: '', category: '', series: '' };
        if (clearQuery) input.value = '';
        updateUrl();
        queueSearch(true);
        input.focus();
      };
      input.addEventListener('focus', () => { void loadIndex().catch(() => {}); }, eventOptions);
      input.addEventListener('input', () => queueSearch(), eventOptions);
      input.addEventListener('compositionstart', () => { composing = true; queueSearch(); }, eventOptions);
      input.addEventListener('compositionend', () => { composing = false; queueSearch(); }, eventOptions);
      form.addEventListener('submit', (event) => { event.preventDefault(); updateUrl(); queueSearch(true); }, eventOptions);
      retry.addEventListener('click', () => queueSearch(true), eventOptions);
      clear.addEventListener('click', clearSearch, eventOptions);
      resetFilters.addEventListener('click', () => resetTaxonomy(), eventOptions);
      more.addEventListener('click', () => { resultLimit += 20; queueSearch(true, false); }, eventOptions);
      root.addEventListener('keydown', (event) => {
        if (event.isComposing) return;
        if (event.key === 'Escape') { event.preventDefault(); resetTaxonomy(true); return; }
        if (event.key !== 'ArrowDown' && event.key !== 'ArrowUp') return;
        const links = [...results.querySelectorAll<HTMLAnchorElement>('a')];
        if (!links.length) return;
        const activeIndex = links.findIndex((link) => link === document.activeElement);
        if (document.activeElement !== input && activeIndex < 0) return;
        event.preventDefault();
        if (event.key === 'ArrowDown') links[Math.min(activeIndex + 1, links.length - 1)].focus();
        else if (activeIndex <= 0) input.focus();
        else links[activeIndex - 1].focus();
      }, eventOptions);

      const syncFromUrl = (): void => {
        const filters = readFiltersFromUrl(location.href);
        input.value = filters.q;
        taxonomy = { tag: filters.tag, category: filters.category, series: filters.series ?? '' };
        queueSearch(true);
      };
      window.addEventListener('popstate', syncFromUrl, eventOptions);
      syncFromUrl();
      scope.add(() => { revision += 1; cache = undefined; results.replaceChildren(); });
    }
  });
</script>